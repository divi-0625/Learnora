# Copy this file to ".env" and put your real values there.
# NEVER commit the real .env file or share it.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Model name. Check https://ai.google.dev/gemini-api/docs/models for current models.
GEMINI_MODEL=gemini-3.5-flash-lite

# Port for the Express server
PORT=5000

# Frontend origin(s), comma-separated. Keep these local URLs for development.
# For deployment, set this to your frontend URL in the hosting provider settings.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas connection string (include the database name edu_assistant)
MONGODB_URI=your_mongodb_connection_string_here

# A long random secret used to sign login tokens (at least 32 characters)
JWT_SECRET=your_long_random_secret_here

# Optional: how long a login lasts (default 7d)
# JWT_EXPIRES_IN=7d

# ----- Backup AI (OpenAI). Used ONLY if Gemini hits its quota or has a temporary outage -----
OPENAI_API_KEY=
# Pick a current model ID from https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-4.1-mini
# Optional, only for models that support it (leave commented out normally)
# OPENAI_REASONING_EFFORT=low

# ----- TEST ONLY: pretend Gemini failed, to try the backup safely. Ignored when NODE_ENV=production.
# Leave this commented out normally.
# AI_TEST_FORCE_GEMINI_ERROR=429
